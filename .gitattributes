* text=auto eol=lf
# Windows command scripts need CRLF when executed by cmd.exe.
*.bat text eol=crlf
# Build and test fixtures are binary and must never be line-normalized.
*.whl binary -eol
*.xlsx binary -eol
# Preserve native HY-8 fixture bytes and their padded cards for provenance.
tests/floodway.hy8 -text whitespace=-blank-at-eol
tests/fixtures/*.hy8 -text whitespace=-blank-at-eol
reference_docs/ShapeDB.dat filter=lfs diff=lfs merge=lfs -text
